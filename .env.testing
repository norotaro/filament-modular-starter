# Committed test-environment anchor.
#
# With APP_ENV=testing (set by phpunit.xml), Laravel's LoadEnvironmentVariables
# bootstrapper loads this file instead of probing for an absent .env. phpdotenv
# reads .env through @file_get_contents, and PHPUnit 13 records that suppressed
# "failed to open stream" warning as a test-triggered warning on every booted
# test — the anchor keeps the suite green on fresh clones with no .env.
#
# Test values live in phpunit.xml. The database is the one exception: artisan
# commands run with --env=testing never read phpunit.xml, so without these lines
# `migrate:fresh --env=testing` falls back to database/database.sqlite and wipes
# the local database.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
