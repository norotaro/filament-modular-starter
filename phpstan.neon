includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    # tests/Fixtures exercises Core's reusable traits, which an application
    # without modules of its own would otherwise leave unused.
    paths:
        - app/
        - tests/Fixtures/

    # Level 10 is the highest level
    level: 5

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
